+}
+
+export type Favorite = {
+  productId: number
+  name: string
+  shortDescription: string
+  price: number
+  stock: number
+}
+
+export type OrderStatus = 'New' | 'AwaitingPayment' | 'Processing' | 'Completed' | 'Cancelled'
+
+export type OrderItem = {
+  productId: number
+  productName: string
+  unitPrice: number
+  quantity: number
+  lineTotal: number
+}
+
+export type Order = {
+  id: number
+  createdAt: string
