+          </p>
+        ) : null}
+        <Button type="submit" disabled={busy}>Надіслати посилання</Button>
+      </form>
+      <p className="text-sm"><Link className="text-brand-800" to="/login">Повернутися до входу</Link></p>
+    </section>
+  )
+}
