+      <div className="rounded-xl border border-stone-200 bg-white p-4 text-sm">
+        <p>{order.recipientName}, {order.phone}</p>
+        <p>{order.city}, {deliveryLabel[order.deliveryMethod] ?? order.deliveryMethod}: {order.deliveryAddress}</p>
