+}
+
+export type MessageResponse = {
+  message: string
+  resetUrl?: string | null
+}
+
+export type Product = {
+  id: number
+  name: string
+  shortDescription: string
+  price: number
+  stock: number
+  averageRating: number | null
+  reviewCount: number
+}
+
+export type Review = {
+  id: number
+  rating: number
+  text: string
+  authorName: string
+  createdAt: string
+  isMine: boolean
+}
+
+export type ProductDetails = Product & {
+  isFavorite: boolean
+  cartQuantity: number
